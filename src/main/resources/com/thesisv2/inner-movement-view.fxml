<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<SplitPane fx:id="SplitPaneControll"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.thesisv2.InnerMovmentController">

    <items>

        <VBox prefWidth="300.0" minWidth="300.0" maxWidth="300.0" spacing="10.0" style="-fx-background-color: #eeeeee;">
            <children>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Τύπος κίνησης">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="MovementTypeCombo" prefWidth="260.0"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Ημερομηνία">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <DatePicker fx:id="MovementDatePicker"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Αποθήκη προέλευσης">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="SourceWarehouseCombo" prefWidth="260.0"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Αποθήκη προορισμού">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <ComboBox fx:id="DestinationWarehouseCombo" prefWidth="260.0"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Σχόλια">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Label>
                        <TextArea fx:id="NotesArea" prefHeight="180.0" wrapText="true"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

            </children>
        </VBox>

        <VBox spacing="10.0">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="HeaderInfoLabel" text="Ενδοδιακίνηση">
                            <font>
                                <Font name="System Bold" size="16.0"/>
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="SaveButton"
                                mnemonicParsing="false"
                                onAction="#handleSaveMovement"
                                prefWidth="120.0"
                                text="Αποθήκευση"/>

                        <Button fx:id="SavePdfButton"
                                mnemonicParsing="false"
                                onAction="#handleSavePdf"
                                prefWidth="140.0"
                                text="Αποθήκευση PDF"/>

                        <Button fx:id="PrintButton"
                                mnemonicParsing="false"
                                onAction="#handlePrint"
                                prefWidth="110.0"
                                text="Εκτύπωση"/>

                        <Button fx:id="ClearButton"
                                mnemonicParsing="false"
                                onAction="#handleClearAll"
                                prefWidth="120.0"
                                text="Καθαρισμός"/>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0" top="10.0"/>
                    </padding>
                </HBox>

                <TableView fx:id="MovementLinesTable" editable="true" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="ColLineNo" prefWidth="70.0" text="Γραμμή"/>
                        <TableColumn fx:id="ColProductId" prefWidth="120.0" text="Κωδικός"/>
                        <TableColumn fx:id="ColDescription" prefWidth="320.0" text="Περιγραφή"/>
                        <TableColumn fx:id="ColQuantity" prefWidth="120.0" text="Ποσότητα"/>
                    </columns>
                </TableView>

                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="AddLineButton"
                                        mnemonicParsing="false"
                                        onAction="#handleAddLine"
                                        prefWidth="150.0"
                                        text="Προσθήκη γραμμής"/>

                                <Button fx:id="RemoveLineButton"
                                        mnemonicParsing="false"
                                        onAction="#handleRemoveSelectedLine"
                                        prefWidth="150.0"
                                        text="Αφαίρεση γραμμής"/>
                            </children>
                            <padding>
                                <Insets left="10.0" right="10.0" bottom="10.0"/>
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0" bottom="10.0"/>
                    </padding>
                </VBox>

            </children>
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
        </VBox>

    </items>
</SplitPane>